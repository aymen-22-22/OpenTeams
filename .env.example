# Copy to .env and change every password before production.

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
SITE_ADDRESS=localhost
# Only when another web server (Apache/Nginx) already uses ports 80/443 on this host:
# SITE_ADDRESS=:80, HTTP_BIND=127.0.0.1:8080, HTTPS_BIND=127.0.0.1:8443 (see docs/DEPLOYMENT.md)
HTTP_BIND=80
HTTPS_BIND=443

# Security. Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
SESSION_DAYS=7
# Set to false only for plain-http local testing.
COOKIE_SECURE=true
# Origins allowed to open the WebSocket (JSON list).
ALLOWED_ORIGINS=["https://localhost","http://localhost:5173"]

# PostgreSQL
POSTGRES_USER=openteams
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openteams
# Used when running the API outside Docker (make dev-api). Docker builds its own URL.
DATABASE_URL=postgresql+asyncpg://openteams:change-me@localhost:5432/openteams

# File storage: "local" (a Docker volume) or "nextcloud" (WebDAV)
STORAGE_BACKEND=local
MAX_UPLOAD_MB=100
# Nextcloud: create a dedicated user, then an app password in
# Settings > Security > Devices & sessions. Files go to /<NEXTCLOUD_FOLDER> of that user.
NEXTCLOUD_URL=https://nextcloud.example.local
NEXTCLOUD_USER=openteams
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_FOLDER=OpenTeams

# Personal AI. Each user enters their own API key in the app (stored encrypted).
# Fernet key for encrypting those keys; generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is derived from SECRET_KEY (changing SECRET_KEY then makes stored keys unreadable).
AI_ENCRYPTION_KEY=
AI_DAILY_TOKEN_BUDGET=200000
# Server addresses for local/compatible providers (set by the admin, not by users).
OLLAMA_URL=http://ollama:11434
QWEN_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
TIMEZONE=Europe/Paris

# Notifications and email. Public URL used in email links.
APP_URL=https://localhost
SCHEDULER_ENABLED=true
# Development: Mailpit (http://localhost:8025). Production: your SMTP server.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=OpenTeams <no-reply@openteams.local>

# Email bridge (optional). Emails sent to team+<tag>@example.com are posted in the
# matching conversation (each conversation shows its own address). Leave empty to disable.
BRIDGE_ADDRESS=
BRIDGE_IMAP_HOST=
BRIDGE_IMAP_PORT=993
BRIDGE_IMAP_USER=
BRIDGE_IMAP_PASSWORD=
BRIDGE_IMAP_FOLDER=INBOX
BRIDGE_POLL_SECONDS=60
# Only accept mail your mail server marked dmarc=pass. Set false only if your server
# does not add Authentication-Results headers (e.g. a purely internal server).
BRIDGE_REQUIRE_DMARC=true

# Web push notifications (optional). Generate the keys once with:
#   docker compose run --rm api python -m app.cli vapid-keys
# Keep them stable: new keys make every device subscribe again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Backups (daily, in the "backups" Docker volume)
BACKUP_KEEP_DAYS=14
# Monitoring (docker compose --profile monitoring up): Grafana on 127.0.0.1:3000
GRAFANA_ADMIN_PASSWORD=change-me
