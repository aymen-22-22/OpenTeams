# Copy to .env and change every password before production.

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
SITE_ADDRESS=localhost

# Security. Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
SESSION_DAYS=7
# Set to false only for plain-http local testing.
COOKIE_SECURE=true
# Origins allowed to open the WebSocket (JSON list).
ALLOWED_ORIGINS=["https://localhost","http://localhost:5173"]

# PostgreSQL
POSTGRES_USER=openteams
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openteams
# Used when running the API outside Docker (make dev-api). Docker builds its own URL.
DATABASE_URL=postgresql+asyncpg://openteams:change-me@localhost:5432/openteams

# File storage: "local" (a Docker volume) or "nextcloud" (WebDAV)
STORAGE_BACKEND=local
MAX_UPLOAD_MB=100
# Nextcloud: create a dedicated user, then an app password in
# Settings > Security > Devices & sessions. Files go to /<NEXTCLOUD_FOLDER> of that user.
NEXTCLOUD_URL=https://nextcloud.example.local
NEXTCLOUD_USER=openteams
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_FOLDER=OpenTeams

# Personal AI. Each user enters their own API key in the app (stored encrypted).
# Fernet key for encrypting those keys; generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is derived from SECRET_KEY (changing SECRET_KEY then makes stored keys unreadable).
AI_ENCRYPTION_KEY=
AI_DAILY_TOKEN_BUDGET=200000
# Server addresses for local/compatible providers (set by the admin, not by users).
OLLAMA_URL=http://ollama:11434
QWEN_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
TIMEZONE=Europe/Paris
