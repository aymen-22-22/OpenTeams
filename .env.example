# Copy to .env and change every password before production.

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
SITE_ADDRESS=localhost

# Security. Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
SESSION_DAYS=7
# Set to false only for plain-http local testing.
COOKIE_SECURE=true
# Origins allowed to open the WebSocket (JSON list).
ALLOWED_ORIGINS=["https://localhost","http://localhost:5173"]

# PostgreSQL
POSTGRES_USER=openteams
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openteams
# Used when running the API outside Docker (make dev-api). Docker builds its own URL.
DATABASE_URL=postgresql+asyncpg://openteams:change-me@localhost:5432/openteams

# MinIO (file storage)
MINIO_ROOT_USER=openteams
MINIO_ROOT_PASSWORD=change-me-too
